---
import styles from './Button.module.css';
const { className = '', type = 'submit', ...rest } = Astro.props;
---

<button class:list={[styles.button, className]} type={type} data-loading-class={styles.loading} {...rest}>
  <span data-submit-label data-hidden-text-class={styles.hiddenText}><slot /></span>
  <span class={styles.spinner} data-submit-spinner hidden aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="31.416" stroke-dashoffset="31.416">
        <animate attributeName="stroke-dasharray" dur="2s" values="0 31.416;15.708 15.708;0 31.416;0 31.416" repeatCount="indefinite" />
        <animate attributeName="stroke-dashoffset" dur="2s" values="0;-15.708;-31.416;-31.416" repeatCount="indefinite" />
      </circle>
    </svg>
  </span>
</button>
