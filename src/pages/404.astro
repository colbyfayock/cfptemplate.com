---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404: This page could not be found</title>
    <style>
      html,
      body {
        height: 100%;
      }

      body {
        color: #000;
        background: #fff;
      }

      .not-found {
        height: 100%;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }

      .not-found h1 {
        display: inline-block;
        margin: 0 20px 0 0;
        padding: 0 23px 0 0;
        font-size: 24px;
        font-weight: 500;
        vertical-align: top;
        line-height: 49px;
        border-right: 1px solid rgba(0, 0, 0, 0.3);
      }

      .not-found h2 {
        display: inline-block;
        margin: 0;
        font-size: 14px;
        font-weight: 400;
        line-height: 49px;
      }
    </style>
  </head>
  <body>
    <main class="not-found">
      <div><h1>404</h1><h2>This page could not be found.</h2></div>
    </main>
  </body>
</html>
